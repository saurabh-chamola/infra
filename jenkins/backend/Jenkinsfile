pipeline {
    agent any

    environment {
        IMAGE_NAME   = "saurabh0010/mern-backend"
        IMAGE_TAG    = "${BUILD_NUMBER}"
        INFRA_REPO   = "github.com/saurabh-chamola/infra.git"
        INFRA_BRANCH = "main"
    }

    stages {

        stage('Checkout Backend Repository') {
            steps {
                dir('app') {
                    git branch: 'main',
                        url: 'https://github.com/saurabh-chamola/MERN_Stack_CRUD'
                }
            }
        }

        stage('Install Dependencies') {
            steps {
                dir('app/backend') {
                    sh 'npm install'
                }
            }
        }

        stage('Run Tests') {
            steps {
                dir('app/backend') {
                    echo "Skipping tests"
                    // sh 'npm test'
                }
            }
        }

        stage('Build Docker Image') {
            steps {
                dir('app/backend') {
                    sh '''
                    docker build -t $IMAGE_NAME:$IMAGE_TAG .
                    docker tag $IMAGE_NAME:$IMAGE_TAG $IMAGE_NAME:latest
                    '''
                }
            }
        }

        stage('Push Docker Image') {
            steps {
                withCredentials([usernamePassword(
                    credentialsId: 'DockerCreds',
                    usernameVariable: 'DOCKER_USER',
                    passwordVariable: 'DOCKER_PASS'
                )]) {
                    sh '''
                    echo "$DOCKER_PASS" | docker login -u "$DOCKER_USER" --password-stdin

                    docker push $IMAGE_NAME:$IMAGE_TAG
                    docker push $IMAGE_NAME:latest

                    docker logout
                    '''
                }
            }
        }

        stage('Checkout Infra Repository') {
            steps {
                dir('infra') {
                    git branch: "${INFRA_BRANCH}",
                        url: "https://${INFRA_REPO}",
                        credentialsId: 'GitCreds'
                }
            }
        }

        stage('Update Helm values.yaml') {
            steps {
                dir('infra') {
                    sh '''
                    yq -i '.image.tag = strenv(IMAGE_TAG)' helm-charts/backend/values.yaml
                    cat helm-charts/backend/values.yaml
                    '''
                }
            }
        }

        stage('Commit and Push to Infra Repo') {
            steps {
                dir('infra') {
                    withCredentials([usernamePassword(
                        credentialsId: 'GitCreds',
                        usernameVariable: 'GIT_USER',
                        passwordVariable: 'GIT_PASS'
                    )]) {
                        sh '''
                        git config user.email "jenkins@ci.local"
                        git config user.name "Jenkins CI"

                        git add helm-charts/backend/values.yaml
                        git commit -m "Update backend image tag to $IMAGE_TAG" || echo "No changes to commit"

                        git push https://$GIT_USER:$GIT_PASS@${INFRA_REPO} HEAD:${INFRA_BRANCH}
                        '''
                    }
                }
            }
        }
    }
}
